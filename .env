# Copy to .env for local runs. On Railway or Render, set these in the service settings.

ENV=development
JWT_SECRET=change-me-to-a-long-random-string
# Postgres from the host, or leave the sqlite default for a single local file.
DATABASE_URL=postgresql://neondb_owner:npg_oCvpmPswd28S@ep-round-resonance-b4jf4zh6-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# DATABASE_URL=sqlite:///./data/app.db

# In-process scan. Use 900 for every 15 minutes. Also call POST /api/system/scan
# from an external cron if the host sleeps.
SCHEDULER_ENABLED=true
SCAN_INTERVAL_SECONDS=60
SIGNAL_EXPIRY_HOURS=6
MIN_MINUTES_BETWEEN=15
CRON_KEY=

# Create a bot with @BotFather, add it to the channel as an admin, and paste both.
TELEGRAM_BOT_TOKEN=8978435333:AAHD7EPpyp2C8WPwyalfv22WVzYd8CrfJKs
TELEGRAM_CHANNEL_ID=-1003890043129

# Reference size printed in the channel. Each account is sized from its own balance.
TELEGRAM_REFERENCE_BALANCE=50
TELEGRAM_REFERENCE_RISK=1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API Key for Massive.com market data feed
MASSIVE_API_KEY=

